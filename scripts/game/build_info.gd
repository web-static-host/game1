## [заголовок, строки] карточки; пусто — описания нет.
static func card(key: String, purpose := 0) -> Array:
	if TOOLS.has(key):
		var t: Array = TOOLS[key]
		return [t[0], t.slice(1)]
	if key == "room":
		if purpose == 0:
			return ["Пустая комната", ["Куда: где угодно, от готовой выработки или с поверхности.", "Назначение выберете потом — в её карточке."]]
		var r: Array = ROOMS.get(purpose, [])
		if r.is_empty():
			return [RoomType.purpose_name(purpose), [RoomType.purpose_hint(purpose)]]
		return [RoomType.purpose_name(purpose), ["Куда: " + r[0], "Как: " + r[1], r[2]]]
	return []
